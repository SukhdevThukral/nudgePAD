{
    "keyboard_name": "nudegPAD",
    "manufacturer": "sukhdev",
    "maintainer": "sukhdevvv",
    "processor": "RP2040",
    "bootloader":"rp2040",
    "usb":{
        "vid": "0xFEED",
        "pid": "0x0000",
        "device_version":"1.0.0"
    },
    "features":{
        "bootmagic": true,
        "extrakey": true,
        "encoder": true
    },
    "matrix_pins":{
        "direct":[
            ["GP3", "GP4", "GP2", "GP1", "GP0", "GP28"]
        ]
    }, "encoder":{
        "rotary":[
            {"pin_a": "GP26", "pin_b": "GP27", "resolution": 4}
        ]
    }, 
    "layouts":{
        "LAYOUT":{
            "layout":[
                {"matrix": [0,0], "x": 0, "y": 0},
                {"matrix": [0,1], "x": 1, "y": 0},
                {"matrix": [0,2], "x": 2, "y": 0},
                {"matrix": [0,3], "x": 3, "y": 0},
                {"matrix": [0,4], "x": 4, "y": 0},
                {"matrix": [0,5], "x": 2, "y": 1}
            ]
        }
    }
}